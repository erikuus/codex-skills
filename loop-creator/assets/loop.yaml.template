schema_version: 1
name: "replace-me"

files:
  input: "input.md"
  criteria: "criteria.md"
  overview: "overview.html"
  state: "state/loop_state.json"

candidate:
  format: "markdown"
  id: "content-hash"
  archive_dir: "candidates/archive"
  pending_dir: "candidates/pending"

evaluation:
  format: "json"
  score_scale: "0..100"
  required_fields:
    - "candidate_id"
    - "input_hash"
    - "criteria_hash"
    - "raw_scores"
    - "final_score"
    - "verdict"
    - "rationale"

selection:
  mode: "single-winner"
  promotion: "strictly-higher-final-score"
  ties: "preserve-incumbent"

automations:
  creator:
    required: true
    workspace: "creator/workspace"
    may_read:
      - "creator/workspace/input.md"
      - "creator/workspace/candidate.template.md"
    must_not_read:
      - "criteria.md"
      - "evaluations"
      - "state"
      - "overview.html"
  evaluator:
    required: true
    workspace: "evaluator/workspace"
    may_read:
      - "evaluator/workspace/candidate.md"
      - "evaluator/workspace/criteria.md"
      - "evaluator/evaluation.template.json"
    must_not_read:
      - "state"
      - "evaluations"
      - "candidates/archive"
      - "overview.html"
