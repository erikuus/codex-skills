#!/usr/bin/env bash
# Run in your own Terminal: sudo prompts there, outside chat and tool logs.
set -euo pipefail

if [[ $# -ne 0 ]]; then
    echo 'Usage: bin/server-audit' >&2
    exit 2
fi
repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
audit_file="$repo_root/ops/server-audit.sh"
audit_sha=$(/usr/bin/shasum -a 256 "$audit_file" | /usr/bin/awk '{ print $1 }')
remote_file=".kaardid-setup/server-audit-$audit_sha.sh"
ssh_options=(-o StrictHostKeyChecking=yes -o ForwardAgent=no)

echo 'Uploading the read-only audit. The sudo password will be requested by the VM.'
ssh "${ssh_options[@]}" kaardid \
    "umask 077; mkdir -p .kaardid-setup && cat > '$remote_file'" < "$audit_file"
remote_sha=$(ssh "${ssh_options[@]}" kaardid "sha256sum '$remote_file'" | /usr/bin/awk '{ print $1 }')
if [[ "$remote_sha" != "$audit_sha" ]]; then
    echo 'Uploaded audit checksum mismatch; nothing will be run with sudo.' >&2
    exit 1
fi

# tee runs as erik; its private output file lets Codex read the audit afterwards.
ssh -t "${ssh_options[@]}" kaardid \
    "umask 077; set -o pipefail; sudo -- /bin/bash '$remote_file' | tee .kaardid-setup/admin-audit.txt"
echo 'Audit saved on the VM at /home/erik/.kaardid-setup/admin-audit.txt.'
