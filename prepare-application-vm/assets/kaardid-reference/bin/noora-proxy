#!/usr/bin/env bash
# Send SSH through Noora's current interface without changing system routes.
set -euo pipefail

if [[ $# -ne 2 || ! "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*$ || ! "$2" =~ ^[0-9]{1,5}$ ]]; then
    echo 'Usage: noora-proxy hostname port' >&2
    exit 2
fi
if (( 10#$2 < 1 || 10#$2 > 65535 )); then
    echo 'Port must be between 1 and 65535.' >&2
    exit 2
fi

vpn_status=$(/usr/sbin/scutil --nc status Noora)
if [[ "$vpn_status" != Connected$'\n'* ]]; then
    echo 'Noora VPN is disconnected. Connect it in macOS VPN settings first.' >&2
    exit 1
fi
vpn_interface=$(printf '%s\n' "$vpn_status" | /usr/bin/awk '$1 == "InterfaceName" && $2 == ":" { print $3; exit }')
if [[ ! "$vpn_interface" =~ ^ppp[0-9]+$ ]]; then
    echo 'Cannot determine Noora VPN interface; refusing to use the ordinary network route.' >&2
    exit 1
fi

exec /usr/bin/nc -b "$vpn_interface" -G 10 "$1" "$2"
