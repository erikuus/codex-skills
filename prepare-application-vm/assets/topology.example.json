{
  "schemaVersion": 1,
  "hosts": [
    {
      "id": "archive-apps",
      "sshAlias": "archive-apps",
      "capacity": {
        "vcpu": 4,
        "ramGiB": 8
      },
      "setupLock": "/run/lock/application-vm-setup.lock",
      "operatorRole": "operator"
    },
    {
      "id": "archive-services",
      "sshAlias": "archive-services",
      "capacity": {
        "vcpu": 4,
        "ramGiB": 8
      },
      "setupLock": "/run/lock/application-vm-setup.lock",
      "operatorRole": "operator"
    }
  ],
  "apps": [
    {
      "id": "addresses",
      "host": "archive-apps",
      "repository": "/Users/operator/dev/php/addresses",
      "framework": "yii1",
      "publicOrigin": "https://addresses.example.org",
      "environments": {
        "rehearsal": {
          "root": "/srv/addresses",
          "serviceUser": "addresses",
          "fpmSocket": "/run/php/addresses-rehearsal.sock",
          "probePort": 18080,
          "database": {
            "cluster": "main",
            "name": "addresses_rehearsal",
            "ownerRole": "addresses_rehearsal_owner",
            "migrationRole": "addresses_rehearsal_migrate",
            "appRole": "addresses_rehearsal_app"
          },
          "setupRoot": "/home/operator/.addresses-setup/rehearsal",
          "unitNames": [],
          "webTunnelPort": 18100,
          "dbTunnelPort": 15432
        },
        "production": {
          "root": "/srv/addresses-production",
          "serviceUser": "addresses-prod",
          "fpmSocket": "/run/php/addresses-production.sock",
          "probePort": 18081,
          "database": {
            "cluster": "main",
            "name": "addresses_production",
            "ownerRole": "addresses_production_owner",
            "migrationRole": "addresses_production_migrate",
            "appRole": "addresses_production_app"
          },
          "setupRoot": "/home/operator/.addresses-setup/production",
          "unitNames": [],
          "webTunnelPort": 18101,
          "dbTunnelPort": 15433
